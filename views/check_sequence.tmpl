<div class="container mt-4">
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Note:</strong> Checking all sequences may take a few moments depending on the number entered.
    </div>
    <h1>Check Number in Sequences</h1>
    <p class="text-muted">Enter a number to see which mathematical sequences it belongs to.</p>
    
    <form id="checkForm" class="mb-4">
        <div class="input-group">
            <input type="number" class="form-control" id="numberInput" placeholder="Enter a number..." required>
            <button class="btn btn-primary" type="submit">Check</button>
        </div>
    </form>

    <div id="loadingIndicator" class="text-center my-4" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Checking sequences...</p>
    </div>

    <div id="resultsContainer" style="display:none;">
        <h3>Results</h3>
        <div id="noResults" class="alert alert-info" style="display:none;">
            The number <strong id="searchedNumberNone"></strong> was not found in any common sequences.
        </div>
        <div id="resultsList" class="row">
            <!-- Results will be injected here -->
        </div>
    </div>

    <div id="errorContainer" class="alert alert-danger mt-4" style="display:none;"></div>
</div>

<template id="resultCardTemplate">
    <div class="col-md-6 col-lg-4 mb-3">
        <div class="card h-100 border-success shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span class="seq-name"></span>
                </h5>
                <p class="card-text">
                    <strong>Value:</strong> <span class="seq-val"></span><br>
                    <span class="seq-index-container" style="display:none;">
                        <strong>Position:</strong> <span class="seq-index"></span>
                    </span>
                </p>
            </div>
        </div>
    </div>
</template>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('checkForm');
    const input = document.getElementById('numberInput');
    const loading = document.getElementById('loadingIndicator');
    const resultsContainer = document.getElementById('resultsContainer');
    const resultsList = document.getElementById('resultsList');
    const noResults = document.getElementById('noResults');
    const searchedNumberNone = document.getElementById('searchedNumberNone');
    const errorContainer = document.getElementById('errorContainer');
    const template = document.getElementById('resultCardTemplate');

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const number = input.value;
        if (!number) return;

        // Reset UI
        resultsContainer.style.display = 'none';
        resultsList.innerHTML = '';
        noResults.style.display = 'none';
        errorContainer.style.display = 'none';
        loading.style.display = 'block';

        fetch('/api/check-number', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ number: number })
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => { throw new Error(text || 'Failed to check sequences'); });
            }
            return response.json();
        })
        .then(data => {
            loading.style.display = 'none';
            resultsContainer.style.display = 'block';
            
            if (!data || data.length === 0) {
                searchedNumberNone.textContent = number;
                noResults.style.display = 'block';
            } else {
                data.forEach(result => {
                    const clone = template.content.cloneNode(true);
                    clone.querySelector('.seq-name').textContent = result.sequenceName;
                    clone.querySelector('.seq-val').textContent = number;
                    
                    if (result.index) {
                        const indexContainer = clone.querySelector('.seq-index-container');
                        indexContainer.style.display = 'inline';
                        clone.querySelector('.seq-index').textContent = result.index;
                    }
                    
                    resultsList.appendChild(clone);
                });
            }
        })
        .catch(error => {
            loading.style.display = 'none';
            errorContainer.textContent = error.message;
            errorContainer.style.display = 'block';
        });
    });
});
</script>
