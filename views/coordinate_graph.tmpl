<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Graph Visualization</h5>
                    <div>
                        <input type="file" id="coordinateFile" accept=".txt,.csv" style="display: none;">
                        <button class="btn btn-primary btn-sm" onclick="document.getElementById('coordinateFile').click()">
                            <i class="bi bi-upload"></i> Load Coordinates
                        </button>
                    </div>
                </div>
                <div class="card-body text-center">
                    <div id="graphContainer" class="bg-body-tertiary" style="width: 100%; height: 600px; border: 1px solid #dee2e6; position: relative; overflow: hidden;">
                        <canvas id="graphCanvas"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="totalLength" class="form-label">Total Length of All Lines</label>
                        <input type="text" class="form-control" id="totalLength" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="lineList" class="form-label">Lines List</label>
                        <select class="form-select" id="lineList" size="15"></select>
                    </div>
                    <div id="lineDetails" class="p-3 border rounded bg-body-secondary d-none">
                        <h6>Line Details</h6>
                        <p class="mb-1"><strong>Length:</strong> <span id="detailLength"></span></p>
                        <p class="mb-1"><strong>Point 1:</strong> (<span id="detailP1"></span>)</p>
                        <p class="mb-0"><strong>Point 2:</strong> (<span id="detailP2"></span>)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const canvas = document.getElementById('graphCanvas');
    const ctx = canvas.getContext('2d');
    const container = document.getElementById('graphContainer');
    const coordinateFile = document.getElementById('coordinateFile');
    const totalLengthInput = document.getElementById('totalLength');
    const lineList = document.getElementById('lineList');
    const lineDetails = document.getElementById('lineDetails');
    const detailLength = document.getElementById('detailLength');
    const detailP1 = document.getElementById('detailP1');
    const detailP2 = document.getElementById('detailP2');

    let graphData = {
        points: [],
        lines: [],
        totalLength: 0
    };

    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    const padding = 50;

    function resizeCanvas() {
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;
        drawGraph();
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    coordinateFile.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const content = e.target.result;
            const points = parsePoints(content);
            if (points.length > 0) {
                processPoints(points);
            } else {
                alert('No valid coordinates found in file. Format should be: X,Y');
            }
        };
        reader.readAsText(file);
    });

    function parsePoints(content) {
        const lines = content.split('\n');
        const points = [];
        lines.forEach(line => {
            const parts = line.trim().split(/[,\s]+/);
            if (parts.length >= 2) {
                const x = parseFloat(parts[0]);
                const y = parseFloat(parts[1]);
                if (!isNaN(x) && !isNaN(y)) {
                    points.push({x, y});
                }
            }
        });
        return points;
    }

    async function processPoints(points) {
        try {
            const response = await fetch('/api/graph/process', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ points: points }),
            });

            if (!response.ok) throw new Error('Failed to process points');

            graphData = await response.json();
            updateUI();
            calculateScale();
            drawGraph();
        } catch (error) {
            console.error('Error:', error);
            alert('Error processing points: ' + error.message);
        }
    }

    function updateUI() {
        totalLengthInput.value = graphData.totalLength.toFixed(4);
        lineList.innerHTML = '';
        graphData.lines.forEach((line, index) => {
            const option = document.createElement('option');
            option.value = index;
            option.textContent = `Line ${index + 1}: (${line.p1.x},${line.p1.y}) to (${line.p2.x},${line.p2.y})`;
            lineList.appendChild(option);
        });
        lineDetails.classList.add('d-none');
    }

    lineList.addEventListener('change', function() {
        const index = this.value;
        if (index !== '') {
            const line = graphData.lines[index];
            detailLength.textContent = line.length.toFixed(4);
            detailP1.textContent = `${line.p1.x}, ${line.p1.y}`;
            detailP2.textContent = `${line.p2.x}, ${line.p2.y}`;
            lineDetails.classList.remove('d-none');
            drawGraph(parseInt(index));
        }
    });

    function calculateScale() {
        if (graphData.points.length === 0) return;

        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        graphData.points.forEach(p => {
            minX = Math.min(minX, p.x);
            maxX = Math.max(maxX, p.x);
            minY = Math.min(minY, p.y);
            maxY = Math.max(maxY, p.y);
        });

        // Always include (0,0) or at least ensure some range
        minX = Math.min(minX, 0);
        maxX = Math.max(maxX, 0);
        minY = Math.min(minY, 0);
        maxY = Math.max(maxY, 0);

        const rangeX = maxX - minX || 10;
        const rangeY = maxY - minY || 10;

        const availableWidth = canvas.width - (padding * 2);
        const availableHeight = canvas.height - (padding * 2);

        scale = Math.min(availableWidth / rangeX, availableHeight / rangeY);
        
        offsetX = padding - (minX * scale);
        offsetY = canvas.height - padding + (minY * scale); // Invert Y for screen coordinates
    }

    function toScreenX(x) {
        return offsetX + (x * scale);
    }

    function toScreenY(y) {
        return offsetY - (y * scale);
    }

    function drawGraph(highlightIndex = -1) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        if (graphData.points.length === 0) {
            // Draw empty axes
            drawAxes();
            return;
        }

        drawAxes();

        // Draw lines
        graphData.lines.forEach((line, index) => {
            ctx.beginPath();
            ctx.moveTo(toScreenX(line.p1.x), toScreenY(line.p1.y));
            ctx.lineTo(toScreenX(line.p2.x), toScreenY(line.p2.y));
            
            if (index === highlightIndex) {
                ctx.strokeStyle = '#ff0000';
                ctx.lineWidth = 3;
            } else {
                ctx.strokeStyle = '#007bff';
                ctx.lineWidth = 1;
            }
            ctx.stroke();
        });

        // Draw points
        graphData.points.forEach(p => {
            ctx.beginPath();
            ctx.arc(toScreenX(p.x), toScreenY(p.y), 4, 0, Math.PI * 2);
            ctx.fillStyle = '#28a745';
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 1;
            ctx.stroke();

            // Label points
            ctx.fillStyle = '#6c757d';
            ctx.font = '10px Arial';
            ctx.fillText(`(${p.x},${p.y})`, toScreenX(p.x) + 5, toScreenY(p.y) - 5);
        });
    }

    function drawAxes() {
        const axisColor = '#adb5bd';
        ctx.strokeStyle = axisColor;
        ctx.lineWidth = 1;
        ctx.setLineDash([5, 5]);

        // Y axis
        const zeroX = toScreenX(0);
        ctx.beginPath();
        ctx.moveTo(zeroX, 0);
        ctx.lineTo(zeroX, canvas.height);
        ctx.stroke();

        // X axis
        const zeroY = toScreenY(0);
        ctx.beginPath();
        ctx.moveTo(0, zeroY);
        ctx.lineTo(canvas.width, zeroY);
        ctx.stroke();

        ctx.setLineDash([]);
        
        // Axis markers
        ctx.fillStyle = axisColor;
        ctx.font = '12px Arial';
        ctx.fillText('Y', zeroX + 5, 15);
        ctx.fillText('X', canvas.width - 15, zeroY - 5);
    }
</script>
