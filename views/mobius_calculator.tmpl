<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2>Möbius Numbers Calculator</h2>
            <p class="text-muted">Analyze numbers using the Möbius function μ(n).</p>
        </div>
    </div>

    <ul class="nav nav-tabs" id="mobiusTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="direct-tab" data-bs-toggle="tab" data-bs-target="#direct" type="button" role="tab">Direct Evaluation</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="mask-tab" data-bs-toggle="tab" data-bs-target="#mask" type="button" role="tab">Index Masking</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="divisor-tab" data-bs-toggle="tab" data-bs-target="#divisor" type="button" role="tab">Divisor Summation & Inversion</button>
        </li>
    </ul>

    <div class="tab-content border-start border-end border-bottom p-4" id="mobiusTabsContent">
        <!-- Direct Evaluation -->
        <div class="tab-pane fade show active" id="direct" role="tabpanel">
            <h4>Direct Evaluation</h4>
            <p>Enter a single integer or a comma-separated list of integers to calculate their Möbius values.</p>
            <div class="input-group mb-3">
                <input type="text" id="directInput" class="form-control" placeholder="e.g. 1, 2, 3, 4, 6, 10, 30">
                <button class="btn btn-primary" type="button" id="btnDirect">Evaluate</button>
            </div>
            <div id="directResult" class="mt-3"></div>
        </div>

        <!-- Index Masking -->
        <div class="tab-pane fade" id="mask" role="tabpanel">
            <h4>Sequential Index Masking</h4>
            <p>Enter a list of numbers (comma-separated). Each number at 1-based index <i>i</i> will be multiplied by μ(i).</p>
            <div class="input-group mb-3">
                <input type="text" id="maskInput" class="form-control" placeholder="e.g. 10.5, 20, 30.1, 40">
                <button class="btn btn-primary" type="button" id="btnMask">Apply Mask</button>
            </div>
            <div id="maskResult" class="mt-3"></div>
        </div>

        <!-- Divisor Summation -->
        <div class="tab-pane fade" id="divisor" role="tabpanel">
            <h4>Divisor Summation & Inversion</h4>
            <p>Enter an integer <i>n</i> to verify ∑<sub>d|n</sub> μ(d) and calculate a Möbius inversion step.</p>
            <div class="input-group mb-3">
                <input type="number" id="divisorInput" class="form-control" placeholder="Enter n (e.g. 12)" min="1">
                <button class="btn btn-primary" type="button" id="btnDivisor">Calculate</button>
            </div>
            <div id="divisorResult" class="mt-3"></div>
        </div>
    </div>
</div>

<script>
    // Helper to render table
    function renderTable(containerId, headers, rows) {
        let html = '<table class="table table-striped table-hover mt-3"><thead><tr>';
        headers.forEach(h => html += `<th>${h}</th>`);
        html += '</tr></thead><tbody>';
        rows.forEach(r => {
            html += '<tr>';
            r.forEach(c => html += `<td>${c}</td>`);
            html += '</tr>';
        });
        html += '</tbody></table>';
        document.getElementById(containerId).innerHTML = html;
    }

    // Direct Evaluation
    document.getElementById('btnDirect').addEventListener('click', async () => {
        const input = document.getElementById('directInput').value;
        const response = await fetch('/api/mobius/direct', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ numbers: input })
        });
        const data = await response.json();
        const rows = data.map(item => [
            item.n,
            `μ(${item.n}) = <b>${item.mu}</b>`,
            item.reason ? `<span class="badge bg-warning text-dark">${item.reason}</span>` : '<span class="badge bg-success">square-free</span>'
        ]);
        renderTable('directResult', ['Number (n)', 'Möbius Value μ(n)', 'Status'], rows);
    });

    // Index Masking
    document.getElementById('btnMask').addEventListener('click', async () => {
        const input = document.getElementById('maskInput').value.split(',').map(Number);
        const response = await fetch('/api/mobius/mask', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: input })
        });
        const data = await response.json();
        const rows = data.map((val, i) => [i + 1, input[i], val]);
        renderTable('maskResult', ['Index (i)', 'Original Value', 'Transformed (Value × μ(i))'], rows);
    });

    // Divisor Summation
    document.getElementById('btnDivisor').addEventListener('click', async () => {
        const n = parseInt(document.getElementById('divisorInput').value);
        const response = await fetch('/api/mobius/divisor', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ n: n })
        });
        const data = await response.json();
        
        let html = `
            <div class="card mt-3">
                <div class="card-body">
                    <h5 class="card-title">Results for n = ${data.n}</h5>
                    <p class="card-text">
                        <b>Property Verification:</b> ∑<sub>d|${data.n}</sub> μ(d) = <strong>${data.sum_mu_d}</strong> 
                        ${data.sum_mu_d === (data.n === 1 ? 1 : 0) ? '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Verified</span>' : '<span class="text-danger"><i class="bi bi-x-circle-fill"></i> Failed</span>'}
                    </p>
                    <p class="card-text"><b>Divisors:</b> ${data.divisors.join(', ')}</p>
                    <hr>
                    <h6>Möbius Inversion Step (Example with g(d) = d):</h6>
                    <p>Calculation: ∑<sub>d|n</sub> μ(n/d) · g(d)</p>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>d</th>
                                <th>n/d</th>
                                <th>μ(n/d)</th>
                                <th>g(d)</th>
                                <th>Term</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${data.inversion_details.map(item => `
                                <tr>
                                    <td>${item.d}</td>
                                    <td>${data.n / item.d}</td>
                                    <td>${item.mu_n_d}</td>
                                    <td>${item.g_d}</td>
                                    <td>${item.term}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <td colspan="4" class="text-end"><strong>Total Inversion Sum:</strong></td>
                                <td><strong>${data.total_inversion}</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        `;
        document.getElementById('divisorResult').innerHTML = html;
    });
</script>
